<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Cambiamos AnchorPane por VBox para un centrado perfecto y conectamos el CSS -->
<VBox alignment="CENTER" spacing="40.0" prefHeight="500.0" prefWidth="700.0" 
      stylesheets="@estilos.css" styleClass="fondo-principal" 
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.estructuras.tictactoe.view.controllers.SeleccionController">
    
    <Label text="Configuración de Partida" styleClass="titulo" />
    
    <HBox alignment="CENTER" spacing="50.0">
        
        <!-- PANEL JUGADOR 1 -->
        <VBox alignment="CENTER" spacing="20.0" prefWidth="240" styleClass="tarjeta">
            <Label text="Jugador 1" style="-fx-font-size: 24px; -fx-text-fill: #2EC4B6; -fx-font-weight: bold;" />
            
            <VBox alignment="CENTER" spacing="10">
                <Label text="Símbolo:" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER" spacing="15.0">
                    <RadioButton fx:id="rbX1" text="X" selected="true" styleClass="radio-candy" />
                    <RadioButton fx:id="rbO1" text="O" styleClass="radio-candy"/>
                </HBox>
            </VBox>
            
            <VBox alignment="CENTER" spacing="10">
                <Label text="Tipo:" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER" spacing="15.0">
                    <RadioButton fx:id="rbHumano1" text="Humano" selected="true" styleClass="radio-candy" />
                    <RadioButton fx:id="rbPC1" text="PC" styleClass="radio-candy" />
                </HBox>
            </VBox>
        </VBox>
        
        <!-- PANEL JUGADOR 2 -->
        <VBox alignment="CENTER" spacing="20.0" prefWidth="240" styleClass="tarjeta">
            <Label text="Jugador 2" style="-fx-font-size: 24px; -fx-text-fill: #FF9F1C; -fx-font-weight: bold;" />
            
            <VBox alignment="CENTER" spacing="10">
                <Label text="Símbolo:" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER" spacing="15.0">
                    <RadioButton fx:id="rbX2" text="X" styleClass="radio-candy" />
                    <RadioButton fx:id="rbO2" text="O" selected="true" styleClass="radio-candy" />
                </HBox>
            </VBox>
            
            <VBox alignment="CENTER" spacing="10">
                <Label text="Tipo:" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER" spacing="15.0">
                    <RadioButton fx:id="rbHumano2" text="Humano" styleClass="radio-candy"/>
                    <RadioButton fx:id="rbPC2" text="PC" selected="true" styleClass="radio-candy"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
    
    <!-- BOTONES INFERIORES -->
    <HBox alignment="CENTER" spacing="40.0">
        <Button text="Volver al Menú" onAction="#volverMenu" styleClass="btn-candy, btn-rosa" />
        <Button text="Iniciar Partida" onAction="#iniciarPartida" styleClass="btn-candy, btn-turquesa" />
    </HBox>
    
</VBox>