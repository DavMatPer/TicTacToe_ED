<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Cambiamos AnchorPane por VBox para un centrado perfecto y conectamos el CSS -->
<VBox alignment="TOP_CENTER" spacing="30.0" prefHeight="500.0" prefWidth="700.0" 
      stylesheets="@estilos.css" styleClass="fondo-principal"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.estructuras.tictactoe.view.controllers.CargaViewController">
    
    <padding>
        <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
    </padding>
    
    <!-- Cabecera principal -->
    <Label text="Partidas Guardadas" styleClass="titulo" />
    
    <StackPane VBox.vgrow="ALWAYS">
        
        <!-- Mensaje cuando no hay partidas -->
        <Label fx:id="lblSinPartidas" text="No hay partidas guardadas actualmente." style="-fx-font-size: 18px; -fx-text-fill: #828282;" />
        
        <!-- Contenedor de la lista -->
        <!-- Mantenemos el fondo transparente inline porque el ScrollPane tiene un comportamiento especial en JavaFX -->
        <ScrollPane fx:id="scrollPanePartidas" fitToWidth="true" visible="false" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox fx:id="vboxListaPartidas" spacing="15.0" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        
    </StackPane>
    
    <!-- Botón Rosa Pastel de regreso -->
    <Button fx:id="btnVolver" text="Volver al Menú" onAction="#volverAlMenu" styleClass="btn-candy, btn-rosa" />
    
</VBox>