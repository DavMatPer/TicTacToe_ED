<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- Conectamos el CSS y usamos la clase de fondo -->
<VBox xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml" 
      fx:controller="com.estructuras.tictactoe.view.controllers.MenuViewController" 
      stylesheets="@estilos.css"
      styleClass="fondo-principal"
      alignment="CENTER" spacing="40">

    <!-- Título Principal -->
    <Label text="Tres en Raya" styleClass="titulo" />
           
    <!-- Subtítulo (Mantenemos un estilo simple para texto secundario) -->
    <Label text="Estructuras de Datos" 
           style="-fx-font-size: 18px; -fx-text-fill: #828282; -fx-padding: -30 0 20 0;"/>

    <!-- Contenedor Tarjeta -->
    <VBox alignment="CENTER" spacing="20" maxWidth="350" styleClass="tarjeta">
          
        <!-- Botón Nueva Partida -->
        <Button fx:id="btnNuevaPartida" text="Nueva Partida" onAction="#iniciarNuevaPartida"
                styleClass="btn-candy, btn-naranja" style="-fx-min-width: 200;"/>
                
        <!-- Botón Cargar Partida -->
        <Button fx:id="btnCargarPartida" text="Cargar Partida" onAction="#cargarPartidaGuardada"
                styleClass="btn-candy, btn-turquesa" style="-fx-min-width: 200;"/>
    </VBox>

</VBox>